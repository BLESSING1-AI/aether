# ===========================================
# AETHER - Private AI Relationship Coach
# ===========================================
# Copy this file to .env.local and fill in values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aether

# Supabase (Auth + Database + RLS)
# Create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (or compatible provider)
# Get key at https://platform.openai.com
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: base URL for compatible providers (OpenRouter, Groq, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Auth / Security
# Generate a long random string
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NEXTAUTH_SECRET=change-me-too

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Feature flags
ENABLE_MEMORY=true
ENABLE_JOURNAL=true
ENABLE_CYCLE_TRACKING=true
ENABLE_TONIGHT=true

# Admin
ADMIN_EMAILS=admin@example.com
